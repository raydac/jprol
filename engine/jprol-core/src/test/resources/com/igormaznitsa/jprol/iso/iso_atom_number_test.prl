% Machine-oriented ISO Prolog test suite: atom_number/2
% Adapted from examples/prolog/iso_atom_number_test.prl

:- dynamic(iso_test_total/1).
:- dynamic(iso_test_passed/1).
:- dynamic(iso_test_failure/1).

init_iso_test_state :-
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)),
    assertz(iso_test_total(0)),
    assertz(iso_test_passed(0)).

check_goal(Name, Goal, Expected) :-
    retract(iso_test_total(Total)),
    NextTotal is Total + 1,
    assertz(iso_test_total(NextTotal)),
    catch(
        (\+ \+ call(Goal) -> Actual = true ; Actual = false),
        Error,
        Actual = error(Error)
    ),
    (   Actual == Expected
    ->  retract(iso_test_passed(Passed)),
        NextPassed is Passed + 1,
        assertz(iso_test_passed(NextPassed))
    ;   assertz(iso_test_failure(failed(Name, Expected, Actual)))
    ).

collect_iso_test_result(Total, Passed, Failures) :-
    iso_test_total(Total),
    iso_test_passed(Passed),
    findall(Failure, iso_test_failure(Failure), Failures),
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)).

test_atom_number :-
    check_goal(positive_integer, (atom_number('123', N1), N1 == 123), true),
    check_goal(negative_integer, (atom_number('-123', N2), N2 == -123), true),
    check_goal(positive_float, (atom_number('123.45', N3), N3 == 123.45), true),
    check_goal(negative_float, (atom_number('-123.45', N4), N4 == -123.45), true),
    check_goal(zero_integer, (atom_number('0', N5), N5 == 0), true),
    check_goal(negative_zero_integer, (atom_number('-0', N6), N6 == 0), true),
    check_goal(non_numeric_atom, atom_number('hello', _), false),
    check_goal(alphanumeric_atom, atom_number('123abc', _), false),
    check_goal(valid_integer_456, (atom_number('456', N9), N9 == 456), true),
    check_goal(valid_float_0_99, (atom_number('0.99', N10), N10 == 0.99), true).

run_tests(Total, Passed, Failures) :-
    init_iso_test_state,
    test_atom_number,
    collect_iso_test_result(Total, Passed, Failures).

run_tests :-
    run_tests(Total, Passed, Failures),
    Total > 0,
    Total =:= Passed,
    Failures == [].
