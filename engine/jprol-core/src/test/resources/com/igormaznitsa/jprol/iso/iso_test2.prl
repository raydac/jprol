% Machine-oriented ISO Prolog test suite: family KB, list rules, recursion, dynamic todos
% Adapted from examples/prolog/iso_test2.prl

:- dynamic(iso_test_total/1).
:- dynamic(iso_test_passed/1).
:- dynamic(iso_test_failure/1).
:- dynamic(todo/1).

init_iso_test_state :-
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)),
    assertz(iso_test_total(0)),
    assertz(iso_test_passed(0)).

check_goal(Name, Goal, Expected) :-
    retract(iso_test_total(Total)),
    NextTotal is Total + 1,
    assertz(iso_test_total(NextTotal)),
    catch(
        (\+ \+ call(Goal) -> Actual = true ; Actual = false),
        Error,
        Actual = error(Error)
    ),
    (   Actual == Expected
    ->  retract(iso_test_passed(Passed)),
        NextPassed is Passed + 1,
        assertz(iso_test_passed(NextPassed))
    ;   assertz(iso_test_failure(failed(Name, Expected, Actual)))
    ).

collect_iso_test_result(Total, Passed, Failures) :-
    iso_test_total(Total),
    iso_test_passed(Passed),
    findall(Failure, iso_test_failure(Failure), Failures),
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)).

parent(john, mary).
parent(john, paul).
parent(mary, susan).
parent(paul, david).
parent(paul, lisa).
parent(susan, anna).
parent(david, michael).
parent(lisa, emma).

male(john).
male(paul).
male(david).
male(michael).

female(mary).
female(susan).
female(lisa).
female(anna).
female(emma).

sibling(X, Y) :- parent(Z, X), parent(Z, Y), X \= Y.
grandparent(X, Y) :- parent(X, Z), parent(Z, Y).
ancestor(X, Y) :- parent(X, Y).
ancestor(X, Y) :- parent(X, Z), ancestor(Z, Y).
descendant(X, Y) :- ancestor(Y, X).
uncle_or_aunt(X, Y) :- sibling(X, Z), parent(Z, Y).

list_length([], 0).
list_length([_|T], N) :- list_length(T, N1), N is N1 + 1.

list_member(X, [X|_]).
list_member(X, [_|T]) :- list_member(X, T).

append_list([], L, L).
append_list([H|T], L, [H|R]) :- append_list(T, L, R).

reverse_list([], []).
reverse_list([H|T], Rev) :- reverse_list(T, RevT), append_list(RevT, [H], Rev).

factorial(0, 1).
factorial(N, F) :- N > 0, N1 is N - 1, factorial(N1, F1), F is N * F1.

fibonacci(0, 0).
fibonacci(1, 1).
fibonacci(N, F) :- N > 1, N1 is N - 1, N2 is N - 2, fibonacci(N1, F1), fibonacci(N2, F2), F is F1 + F2.

add_todo(Task) :- assertz(todo(Task)).
remove_todo(Task) :- retract(todo(Task)).
clear_todos :- retractall(todo(_)).

run_tests(Total, Passed, Failures) :-
    init_iso_test_state,
    clear_todos,

    check_goal(family_sibling, sibling(mary, paul), true),
    check_goal(family_grandparent, grandparent(john, susan), true),
    check_goal(family_ancestor, ancestor(john, emma), true),
    check_goal(family_descendant, descendant(emma, john), true),
    check_goal(family_uncle_or_aunt_positive, (uncle_or_aunt(mary, david), uncle_or_aunt(paul, susan)), true),
    check_goal(family_uncle_or_aunt_negative, uncle_or_aunt(mary, anna), false),

    check_goal(list_length_4, (list_length([a, b, c, d], L), L == 4), true),
    check_goal(list_member_check, (list_member(c, [a, b, c, d]), \+ list_member(z, [a, b, c, d])), true),
    check_goal(append_list_check, (append_list([1, 2], [3, 4], AppendedList), AppendedList == [1, 2, 3, 4]), true),
    check_goal(reverse_list_check, (reverse_list([1, 2, 3], ReversedList), ReversedList == [3, 2, 1]), true),

    check_goal(factorial_6, (factorial(6, F), F == 720), true),
    check_goal(fibonacci_10, (fibonacci(10, Fib), Fib == 55), true),

    check_goal(
        dynamic_todos,
        (add_todo('Learn Prolog'),
         add_todo('Write test program'),
         findall(T1, todo(T1), Before),
         Before == ['Learn Prolog', 'Write test program'],
         forall(todo(Task), atom(Task)),
         remove_todo('Learn Prolog'),
         findall(T2, todo(T2), After),
         After == ['Write test program'],
         clear_todos,
         \+ todo(_)),
        true
    ),

    clear_todos,
    collect_iso_test_result(Total, Passed, Failures).

run_tests :-
    run_tests(Total, Passed, Failures),
    Total > 0,
    Total =:= Passed,
    Failures == [].
