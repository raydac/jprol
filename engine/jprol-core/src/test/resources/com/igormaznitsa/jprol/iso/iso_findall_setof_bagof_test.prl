% Machine-oriented ISO Prolog test suite: findall/3, bagof/3, setof/3
% Adapted from examples/prolog/iso_findall_setof_bagof_test.prl

:- dynamic(iso_test_total/1).
:- dynamic(iso_test_passed/1).
:- dynamic(iso_test_failure/1).

init_iso_test_state :-
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)),
    assertz(iso_test_total(0)),
    assertz(iso_test_passed(0)).

check_goal(Name, Goal, Expected) :-
    retract(iso_test_total(Total)),
    NextTotal is Total + 1,
    assertz(iso_test_total(NextTotal)),
    catch(
        (\+ \+ call(Goal) -> Actual = true ; Actual = false),
        Error,
        Actual = error(Error)
    ),
    (   Actual == Expected
    ->  retract(iso_test_passed(Passed)),
        NextPassed is Passed + 1,
        assertz(iso_test_passed(NextPassed))
    ;   assertz(iso_test_failure(failed(Name, Expected, Actual)))
    ).

collect_iso_test_result(Total, Passed, Failures) :-
    iso_test_total(Total),
    iso_test_passed(Passed),
    findall(Failure, iso_test_failure(Failure), Failures),
    retractall(iso_test_total(_)),
    retractall(iso_test_passed(_)),
    retractall(iso_test_failure(_)).

parent(john, mary).
parent(john, mike).
parent(jane, mary).
parent(jane, mike).
parent(susan, ann).
parent(susan, bob).

test_findall :-
    check_goal(
        test_findall,
        (findall(Child, parent(john, Child), Children), Children == [mary, mike]),
        true
    ).

test_findall_empty :-
    check_goal(
        test_findall_empty,
        (findall(Child, parent(nonexistent, Child), Children), Children == []),
        true
    ).

test_bagof_group :-
    check_goal(
        test_bagof_group,
        (setof(Parent-Children, bagof(Child, parent(Parent, Child), Children), Groups),
         Groups == [jane-[mary, mike], john-[mary, mike], susan-[ann, bob]]),
        true
    ).

test_bagof_john :-
    check_goal(
        test_bagof_john,
        (bagof(Child, parent(john, Child), Children), Children == [mary, mike]),
        true
    ).

test_setof_all :-
    check_goal(
        test_setof_all,
        (setof(Child, Parent^parent(Parent, Child), Children),
         Children == [ann, bob, mary, mike]),
        true
    ).

test_setof_john :-
    check_goal(
        test_setof_john,
        (setof(Child, parent(john, Child), Children), Children == [mary, mike]),
        true
    ).

test_setof_pairs :-
    check_goal(
        test_setof_pairs,
        (setof((Parent, Child), parent(Parent, Child), Results),
         Results == [(jane, mary), (jane, mike),
                     (john, mary), (john, mike),
                     (susan, ann), (susan, bob)]),
        true
    ).

run_tests(Total, Passed, Failures) :-
    init_iso_test_state,
    test_findall,
    test_findall_empty,
    test_bagof_group,
    test_bagof_john,
    test_setof_all,
    test_setof_john,
    test_setof_pairs,
    collect_iso_test_result(Total, Passed, Failures).

run_tests :-
    run_tests(Total, Passed, Failures),
    Total > 0,
    Total =:= Passed,
    Failures == [].
