<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      Constructors validate their arguments and call into collaborators.
      These types stay open for extension, so they cannot be final.
      They do not use finalize(), so a thrown constructor is not a finalizer attack.
    -->
    <Match>
        <Class name="com.igormaznitsa.jprol.data.Term"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.kbase.inmemory.AbstractInMemoryKnowledgeBase"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.libs.AbstractJProlLibrary"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.JProlContext"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      These accessors publish the live engine object. A copy would break
      identity that proving, locking, and library dispatch rely on.
    -->
    <Match>
        <Class name="com.igormaznitsa.jprol.exceptions.ProlChoicePointInterruptedException"/>
        <Method name="getChoicePoint"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.exceptions.ProlChoicePointInterruptedException"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.kbase.inmemory.items.InMemoryItem"/>
        <Method name="getClause"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.JProlChoicePoint"/>
        <Method name="getContext"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.JProlContext"/>
        <Method name="getKnowledgeBase"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.JProlContext"/>
        <Method name="getParentContext"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.JProlTreeBuilder"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.PredicateInvoker"/>
        <Method name="getLibrary"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.PredicateInvoker"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.triggers.TriggerEvent"/>
        <Method name="getContext"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.igormaznitsa.jprol.logic.triggers.TriggerEvent"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
